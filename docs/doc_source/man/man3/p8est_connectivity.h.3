*Element, type=C3D8, ELSET=EB1
    1,       6,      19,      23,       7,       8,      21,      27,       9
    2,      19,      13,      16,      23,      21,      14,      18,      27
    3,       7,      23,      22,       4,       9,      27,      25,       5
