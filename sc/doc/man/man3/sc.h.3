.SH "Detailed Description"
.PP 
Support for process management (memory allocation, logging, etc\&.) 


.SH "Macro Definition Documentation"
.PP 
.SS "#define SC_ALLOC_ZERO(t, n)"
\fBValue:\fP
.PP
.nf
                                               (t *) sc_calloc (sc_package_id, \
                                               (size_t) (n), sizeof(t))
.fi
.SS "#define SC_BZERO(p, n)   ((void) memset ((p), 0, (n) * sizeof (*(p))))"

.PP
Sets n elements of a memory range to zero\&. Assumes the pointer p is of the correct type\&. 
.SS "#define SC_GEN_LOG(package, category, priority, s)"
\fBValue:\fP
.PP
.nf
  ((priority) < SC_LP_THRESHOLD ? (void) 0 :                            \
   sc_log (__FILE__, __LINE__, (package), (category), (priority), (s)))
.fi
.SS "#define SC_GEN_LOGF(package, category, priority, fmt,  \&.\&.\&.)"
\fBValue:\fP
.PP
.nf
  ((priority) < SC_LP_THRESHOLD ? (void) 0 :                            \
   sc_logf (__FILE__, __LINE__, (package), (category), (priority),      \
            (fmt), __VA_ARGS__))
.fi
.SS "#define SC_LOG2_16(x)"
\fBValue:\fP
.PP
.nf
                       (((x) > 0xff) ?                                   \
                       (SC_LOG2_8 ((x) >> 8) + 8) : SC_LOG2_8 (x))
.fi
.SS "#define SC_LOG2_32(x)"
\fBValue:\fP
.PP
.nf
                       (((x) > 0xffff) ?                                 \
                       (SC_LOG2_16 ((x) >> 16)) + 16 : SC_LOG2_16 (x))
.fi
.SS "#define SC_LOG2_64(x)"
\fBValue:\fP
.PP
.nf
                       (((x) > 0xffffffffLL) ?                           \
                       (SC_LOG2_32 ((x) >> 32)) + 32 : SC_LOG2_32 (x))
.fi
.SS "#define SC_REALLOC(p, t, n)"
\fBValue:\fP
.PP
.nf
                                             (t *) sc_realloc (sc_package_id,          \
                                             (p), (n) * sizeof(t))
.fi
