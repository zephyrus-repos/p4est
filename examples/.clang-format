BasedOnStyle: LLVM

Standard: c++20
UseTab: Never
IndentWidth: 4

SortIncludes: false

# Line length: 80 characters recommended, comments may be longer
# (might be exceeded in exceptional cases for a maintainable layout)
ColumnLimit: 0
ReflowComments: false

# align declarations and assignments on the left, but not on the right
AlignConsecutiveAssignments: true
AlignConsecutiveDeclarations: true